{
  "info": {
    "_postman_id": "7a32e1b4-1c9f-4321-9876-54321abcdef0",
    "name": "Community Food Sharing - NGO Management (/ngo)",
    "description": "Postman requests for all NGO Coordinator food donation and recipient request reviews.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "ngoToken",
      "value": ""
    },
    {
      "key": "donationId",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as NGO Coordinator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ngo@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('ngoToken', response.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Food Donations Review (/ngo/donations)",
      "item": [
        {
          "name": "Get Pending Donations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/donations/pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending donations list returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donations).to.be.an('array');",
                  "    if (response.donations.length > 0) {",
                  "        pm.collectionVariables.set('donationId', response.donations[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Donation Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/donations/{{donationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation details returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Food Donation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/donations/{{donationId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation approved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation.status).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Food Donation with Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Food items have passed their safe consumption shelf-life and packaging is compromised.\"\n}"
            },
            "url": "{{baseUrl}}/ngo/donations/{{donationId}}/reject"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation rejected successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation.status).to.eql('REJECTED');",
                  "    pm.expect(response.donation.rejectionReason).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Donations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/donations"
          }
        }
      ]
    },
    {
      "name": "2. Recipient Food Requests Review (/ngo/requests)",
      "item": [
        {
          "name": "Get Pending Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/requests/pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending food requests returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.requests).to.be.an('array');",
                  "    if (response.requests.length > 0) {",
                  "        pm.collectionVariables.set('requestId', response.requests[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Request Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request details returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request).to.have.property('id');",
                  "    pm.expect(response.request).to.have.property('foodItem');",
                  "    pm.expect(response.request).to.have.property('recipientId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve Food Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/requests/{{requestId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request approved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request.status).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject Food Request with Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Requested quantity exceeds maximum household allocation for this cycle.\"\n}"
            },
            "url": "{{baseUrl}}/ngo/requests/{{requestId}}/reject"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request rejected successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request.status).to.eql('REJECTED');",
                  "    pm.expect(response.request.rejectionReason).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Food Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/ngo/requests"
          }
        }
      ]
    }
  ]
}
