{
  "info": {
    "_postman_id": "donation-collection-id",
    "name": "Community Food Sharing - Donations",
    "description": "Postman collection for donor side donation workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5001" },
    { "key": "donorEmail", "value": "donor@example.com" },
    { "key": "donorPassword", "value": "StrongPass123" },
    { "key": "donorToken", "value": "" },
    { "key": "donationId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login as Donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{donorEmail}}\",\n  \"password\": \"{{donorPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Donor login returns token', function () {",
            "    pm.response.to.have.status(200);",
            "    const body = pm.response.json();",
            "    pm.expect(body.token).to.be.a('string');",
            "    pm.collectionVariables.set('donorToken', body.token);",
            "});"
          ]}}]
        }
      ]
    },
    {
      "name": "Donations",
      "item": [
        {
          "name": "Create Donation",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{donorToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"category\": \"Cooked Food\",\n  \"quantity\": 5,\n  \"quantityUnit\": \"kg\",\n  \"description\": \"Fresh homemade soup\",\n  \"expiryDate\": \"2024-12-31\",\n  \"pickupLocation\": \"Main Street 12\",\n  \"pickupDateTime\": \"2024-09-01T10:00:00Z\"\n}" },
            "url": "{{baseUrl}}/donations"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Donation created', function () {",
            "    pm.response.to.have.status(201);",
            "    const body = pm.response.json();",
            "    pm.expect(body.donation).to.have.property('_id');",
            "    pm.collectionVariables.set('donationId', body.donation._id);",
            "});"
          ]}}]
        },
        {
          "name": "Get My Donations",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": "{{baseUrl}}/donations"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Fetched donor donations', function () {",
            "    pm.response.to.have.status(200);",
            "});"
          ]}}]
        },
        {
          "name": "Cancel Donation",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": "{{baseUrl}}/donations/{{donationId}}/cancel"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Cancel donation', function () {",
            "    pm.response.to.have.status(200);",
            "});"
          ]}}]
        }
      ]
    }
  ]
}
