{
  "info": {
    "_postman_id": "9b12d1b8-2bf4-4df1-bc95-812046c8209e",
    "name": "Community Food Sharing - Donations & NGO Review",
    "description": "Postman requests for Food Donation management and NGO Coordinator approval/rejection workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "ngoToken",
      "value": ""
    },
    {
      "key": "donorToken",
      "value": ""
    },
    {
      "key": "donationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth Helpers",
      "item": [
        {
          "name": "Login as NGO Coordinator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ngo@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('ngoToken', response.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Donor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\",\n  \"password\": \"StrongPass123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login returns a token', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('donorToken', response.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "NGO Coordinator Actions",
      "item": [
        {
          "name": "1. Get Pending Donations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/donations/pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending donations list returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donations).to.be.an('array');",
                  "    if (response.donations.length > 0) {",
                  "        pm.collectionVariables.set('donationId', response.donations[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get Donation Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/donations/{{donationId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation details returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation).to.have.property('id');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Approve Food Donation",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/donations/{{donationId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation approved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation.status).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Reject Food Donation with Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Food items have passed their safe consumption shelf-life and packaging is compromised.\"\n}"
            },
            "url": "{{baseUrl}}/donations/{{donationId}}/reject"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation rejected successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation.status).to.eql('REJECTED');",
                  "    pm.expect(response.donation.rejectionReason).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Donation Operations",
      "item": [
        {
          "name": "Submit Food Donation (Donor)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{donorToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Surplus Packaged Rice\",\n  \"description\": \"10 sealed boxes of cooked rice ready for distribution.\",\n  \"foodType\": \"Cooked Meal\",\n  \"quantity\": \"10 boxes\",\n  \"unit\": \"boxes\",\n  \"pickupAddress\": \"123 Community Center, Colombo\",\n  \"contactNumber\": \"+94771234567\"\n}"
            },
            "url": "{{baseUrl}}/donations"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Donation created successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.donation).to.have.property('id');",
                  "    pm.collectionVariables.set('donationId', response.donation.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Donations",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/donations"
          }
        }
      ]
    }
  ]
}
