{
  "info": {
    "_postman_id": "4a71b2d0-8e12-4c9f-b98a-1a3b4c5d6e7f",
    "name": "Community Food Sharing - Recipient Requests and NGO Review",
    "description": " Postman collection for recipient food requests and NGO Coordinator approval/rejection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5001"
    },
    {
      "key": "ngoEmail",
      "value": "ngo@example.com"
    },
    {
      "key": "recipientEmail",
      "value": "recipient@example.com"
    },
    {
      "key": "password",
      "value": "StrongPass123"
    },
    {
      "key": "ngoToken",
      "value": ""
    },
    {
      "key": "recipientToken",
      "value": ""
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login as NGO Coordinator",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{ngoEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('NGO login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('ngoToken', response.token);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as Recipient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{recipientEmail}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recipient login successful', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('recipientToken', response.token);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Recipient Operations",
      "item": [
        {
          "name": "1. Submit Food Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recipientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodItem\": \"Cooked Meals\",\n  \"quantityRequested\": \"4 packs\",\n  \"recipientName\": \"Alice\"\n}"
            },
            "url": "{{baseUrl}}/requests"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request submitted successfully', function () {",
                  "    pm.response.to.have.status(201);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request).to.have.property('id');",
                  "    pm.expect(response.request.status).to.eql('PENDING');",
                  "    pm.collectionVariables.set('requestId', response.request.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Request - Missing Food Item",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recipientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantityRequested\": \"2 packs\"\n}"
            },
            "url": "{{baseUrl}}/requests"
          }
        },
        {
          "name": "Create Request - Missing Quantity",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{recipientToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodItem\": \"Bread\"\n}"
            },
            "url": "{{baseUrl}}/requests"
          }
        }
      ]
    },
    {
      "name": "NGO Coordinator Actions",
      "item": [
        {
          "name": "1. Get Pending Food Requests",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/requests/pending"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Pending food requests returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.requests).to.be.an('array');",
                  "    pm.expect(response).to.have.property('count');",
                  "    if (response.requests.length > 0 && !pm.collectionVariables.get('requestId')) {",
                  "        pm.collectionVariables.set('requestId', response.requests[0].id);",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get Food Request Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request details returned', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request).to.have.property('id');",
                  "    pm.expect(response.request).to.have.property('foodItem');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Approve Food Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              }
            ],
            "url": "{{baseUrl}}/requests/{{requestId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request approved successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request.status).to.eql('APPROVED');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Reject Food Request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Requested quantity exceeds available allocation.\"\n}"
            },
            "url": "{{baseUrl}}/requests/{{requestId}}/reject"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Food request rejected successfully', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.request.status).to.eql('REJECTED');",
                  "    pm.expect(response.request.rejectionReason).to.be.a('string').and.not.empty;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "NGO Validation Tests",
      "item": [
        {
          "name": "Reject Request - Missing Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": "{{baseUrl}}/requests/{{requestId}}/reject"
          }
        },
        {
          "name": "Reject Request - Empty Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"    \"\n}"
            },
            "url": "{{baseUrl}}/requests/{{requestId}}/reject"
          }
        },
        {
          "name": "Reject Request - Too Short Reason",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{ngoToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"No\"\n}"
            },
            "url": "{{baseUrl}}/requests/{{requestId}}/reject"
          }
        }
      ]
    }
  ]
}