datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  customUserId String   @unique
  email        String   @unique
  password     String
  roleCode     String

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum DonationStatus {
  AVAILABLE
  CANCELLED
  COLLECTED
  EXPIRED
}

enum QuantityUnit {
  KG
  G
  LITRE
  ML
  PACKETS
  BOXES
  PIECES
}

model FoodDonation {
  id              String         @id @default(auto()) @map("_id") @db.ObjectId

  donorId         String         @db.ObjectId

  category        String
  quantity        Float
  quantityUnit    QuantityUnit
  description     String
  expiryDate      DateTime

  imageUrl        String?

  pickupLocation  String
  pickupDateTime  DateTime

  status          DonationStatus @default(AVAILABLE)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model FoodRequest {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  customRequestId   String?   @unique
  recipientId       String
  recipientEmail    String?
  recipientName     String?
  recipientContact  String?
  deliveryAddress   String?
  donationId        String?
  foodItem          String
  quantityRequested String
  notes             String?
  status            String    @default("PENDING")
  rejectionReason   String?
  reviewedBy        String?
  reviewedAt        DateTime?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}