datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId

  customUserId String   @unique

  email        String   @unique

  password     String

  roleCode     String

  isEmailVerified Boolean @default(false)

  // Recipient profile relation
  recipientProfile Recipient?

  // Email verification OTP
  emailVerificationCodeHash String?

  emailVerificationExpiresAt DateTime?

  // Password reset OTP
  passwordResetCodeHash String?

  passwordResetExpiresAt DateTime?

  createdAt    DateTime @default(now())

  updatedAt    DateTime @updatedAt
}

model Recipient {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Connect to User.customUserId
  customUserId String @unique

  user User @relation(fields: [customUserId], references: [customUserId])

  // Core identifiers
  firstName String

  lastName String

  // NIC (National Identity Card)
  nic String? @unique

  // Contact
  phoneNumber String

  // Address
  addressLine1 String

  addressLine2 String?

  city String

  district String

  // GPS location
  latitude Float?

  longitude Float?

  // Preferences
  timeZone String

  language String

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

enum DonationStatus {
  PENDING
  APPROVED
  REJECTED
  AVAILABLE
  CANCELLED
  COLLECTED
  EXPIRED
}

enum QuantityUnit {
  KG
  G
  LITRE
  ML
  PACKETS
  BOXES
  PIECES
}

enum MatchStatus {
  SUGGESTED
  ACCEPTED
  DECLINED
  EXPIRED
}

model FoodDonation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  donorId String @db.ObjectId

  category String

  quantity Float

  quantityUnit QuantityUnit

  description String

  expiryDate DateTime

  imageUrl String?

  pickupLocation String

  pickupDateTime DateTime

  status DonationStatus @default(PENDING)

  rejectionReason String?

  reviewedBy String?

  reviewedAt DateTime?

  matches FoodMatch[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FoodRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  customRequestId String? @unique

  recipientId String

  recipientEmail String?

  recipientName String?

  recipientContact String?

  deliveryAddress String?

  donationId String?

  foodItem String

  quantityRequested String

  notes String?

  status String @default("PENDING")

  rejectionReason String?

  reviewedBy String?

  reviewedAt DateTime?

  matches FoodMatch[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model FoodMatch {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  donationId String @db.ObjectId
  foodRequestId String @db.ObjectId
  recipientId String

  categoryMatched Boolean
  locationMatched Boolean
  availabilityCheckedAt DateTime
  eligibilityCheckedAt DateTime
  score Int
  status MatchStatus @default(SUGGESTED)

  matchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  donation FoodDonation @relation(fields: [donationId], references: [id])
  foodRequest FoodRequest @relation(fields: [foodRequestId], references: [id])

  @@unique([donationId, foodRequestId])
}

// ====================== VOLUNTEER DELIVERY ======================

enum VolunteerAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}

enum DeliveryStatus {
  PENDING_ASSIGNMENT
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  REJECTED
  CANCELLED
}

enum DeliveryProblemStatus {
  REPORTED
  ACKNOWLEDGED
  RESOLVED
}

model VolunteerAvailability {
  id          String                      @id @default(auto()) @map("_id") @db.ObjectId

  volunteerId String                      @unique

  status      VolunteerAvailabilityStatus @default(UNAVAILABLE)

  notes       String?

  createdAt   DateTime                    @default(now())

  updatedAt   DateTime                    @updatedAt
}

model Delivery {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId

  // The volunteer assigned to this delivery (null = unassigned / available)
  volunteerId String?

  // The donor who listed the food
  donorId     String

  // The recipient who requested the food
  recipientId String

  // Food details
  foodItem        String
  foodQuantityKg  Float          @default(0)
  foodExpiryDate  DateTime?

  // Pickup coordinates (donor location)
  pickupLatitude  Float?
  pickupLongitude Float?
  pickupAddress   String?

  // Drop-off coordinates (recipient location)
  dropoffLatitude  Float?
  dropoffLongitude Float?
  dropoffAddress   String?

  // Status workflow
  status DeliveryStatus @default(PENDING_ASSIGNMENT)

  rejectionReason String?

  // Audit timestamps
  acceptedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  rejectedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tracking DeliveryTracking[]
  problems DeliveryProblem[]
}

model DeliveryTracking {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId

  deliveryId  String   @db.ObjectId
  delivery    Delivery @relation(fields: [deliveryId], references: [id])

  volunteerId String

  status      DeliveryStatus

  latitude    Float?
  longitude   Float?

  message     String?

  createdAt   DateTime @default(now())
}

model DeliveryProblem {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId

  deliveryId  String                @db.ObjectId
  delivery    Delivery              @relation(fields: [deliveryId], references: [id])

  volunteerId String

  problemType String

  description String

  status      DeliveryProblemStatus @default(REPORTED)

  createdAt   DateTime              @default(now())

  updatedAt   DateTime              @updatedAt
}
